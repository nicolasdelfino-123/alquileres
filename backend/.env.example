DATABASE_URL=postgresql://usuario:password@localhost:5432/alquileres_db
JWT_SECRET_KEY=
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Configuración habitual: Gmail desde /configurar-correo, sin editar este archivo.
# En desarrollo la clave se genera en instance/mail.key. En producción es obligatoria.
MAIL_ENCRYPTION_KEY=
TRUSTED_HOSTS=
PROXY_HOPS=0
MAIL_WORKER_AUTOSTART=true

# Alternativa para un SMTP administrado desde el entorno (sin Gmail guardado en la BD).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false

# Alternativa al código del equipo configurado desde la pantalla de correo.
REGISTRATION_CODE=
